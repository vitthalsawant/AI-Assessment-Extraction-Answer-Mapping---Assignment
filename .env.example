GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional: override model (defaults try gemini-3.6-flash, then gemini-flash-latest)
GEMINI_MODEL=gemini-3.6-flash

# Vercel Blob (required in production on Vercel)
# 1. Create a Blob store in Vercel → Storage (e.g. ai-assessment-extraction-an-blob)
# 2. Connect it to this project — Vercel adds BLOB_READ_WRITE_TOKEN automatically
# 3. Locally: run `vercel link` then `vercel env pull` to sync env vars
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: custom directory for file-based sessions (local dev without Vercel)
# SESSION_DIR=.data/sessions
